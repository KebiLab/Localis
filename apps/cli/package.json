{
  "name": "localis",
  "version": "0.2.0",
  "description": "Private, local-first code audits, AI change plans, and release checks.",
  "license": "Apache-2.0",
  "author": "KebiLab",
  "repository": {
    "type": "git",
    "url": "https://github.com/KebiLab/Localis.git",
    "directory": "apps/cli"
  },
  "homepage": "https://localis.dev",
  "bugs": "https://github.com/KebiLab/Localis/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "cli",
    "code-audit",
    "local-first",
    "privacy",
    "developer-tools",
    "ai"
  ],
  "type": "module",
